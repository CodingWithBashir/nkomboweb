{
  "name": "lycee-de-nyanza",
  "version": "1.0.0",
  "private": true,
  "description": "Lyc\u00e9e de Nyanza \u2014 school website (client/, Next.js) and its Node API (server/, Express + SQLite).",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "dev": "node scripts/run.mjs dev",
    "build": "npm --prefix client run build",
    "start": "node scripts/run.mjs start",
    "api": "npm --prefix server run dev",
    "api:start": "npm --prefix server start",
    "web": "npm --prefix client run dev",
    "lint": "npm --prefix client run lint",
    "doctor": "node scripts/doctor.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=22.5"
  }
}
