# ---------------------------------------------------------------------------
# Lycée de Nyanza — API (server/)
# All values have working defaults; copy to .env to change them.
# ---------------------------------------------------------------------------

# Port the API listens on (the website proxies /api/** here)
PORT=4000
HOST=0.0.0.0

# SQLite file (defaults to server/data/school.db)
SCHOOL_DB_PATH=

# Image host used for staff/student photos
IMGBB_API_KEY=d5627ba7e34e1c21d5efa513083c3a95

# Optional: verify Supabase access tokens without the session-bridge function
SUPABASE_JWT_SECRET=
SUPABASE_BRIDGE_SECRET=

# ---------------------------------------------------------------------------
# Outgoing e-mail (acceptance letters, admission decisions, password resets)
#
# Leave everything empty and the portal still works: every message is stored in
# the outbox (/lyceeadmin/outbox) and you can read or re-send it later.
# Fill in ONE of the two blocks below to actually deliver mail.
# ---------------------------------------------------------------------------

# The address your letters come from. Must be allowed by your mail provider.
MAIL_FROM="Lycée de Nyanza <no-reply@lyceedenyanza.rw>"
# Optional: where replies should go (the office inbox).
MAIL_REPLY_TO=lyceedenyanza2018@gmail.com
# Option A — your own mail server (Gmail app password, Zoho, cPanel, Mailtrap…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1 / true for implicit TLS (port 465). Leave empty for STARTTLS on 587.
SMTP_SECURE=
# Alternative one-line form: smtps://user:pass@smtp.gmail.com:465
SMTP_URL=

# Option B — Resend (https://resend.com). Tried FIRST when set; SMTP above is
# then used as the fallback if Resend cannot be reached.
RESEND_API_KEY=

# Public address used in links inside letters. Empty = the host the office is
# browsing from (handy in preview/staging); set it once the site is live.
APP_URL=

# --------------------------------------------------------------- SMS & WhatsApp
# Parents get an SMS when the roll call marks a child absent, and the office can
# message a whole class. Without a provider the messages are still written to
# the message log (Admin → SMS & WhatsApp) so nothing is lost.
#
# Option A — Africa's Talking (https://africastalking.com)
AT_API_KEY=
AT_USERNAME=
# Optional alphanumeric sender, e.g. LYCEE
AT_SENDER=
# Option B — any gateway that accepts POST {to, message} as JSON
SMS_GATEWAY_URL=

# WhatsApp Cloud API (Meta) — optional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ------------------------------------------------------------- MTN MoMo (fees)
# Collections API. With these keys the "MoMo" button on an invoice pushes a
# payment request to the parent phone; without them fees still work by hand.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# mtnrwanda (default), mtnuganda, mtnghana…
MOMO_ENVIRONMENT=
MOMO_CURRENCY=RWF
# Where MTN posts the payment result. Must be public.
MOMO_CALLBACK_URL=
