# ---------------------------------------------------------------------------
# Lycée de Nyanza — API (server/)
# All values have working defaults; copy to .env to change them.
# ---------------------------------------------------------------------------

# Port the API listens on (the website proxies /api/** here)
PORT=4000
HOST=0.0.0.0

# SQLite file (defaults to server/data/school.db)
SCHOOL_DB_PATH=

# Image host used for staff/student photos
IMGBB_API_KEY=d5627ba7e34e1c21d5efa513083c3a95

# Optional: verify Supabase access tokens without the session-bridge function
SUPABASE_JWT_SECRET=
SUPABASE_BRIDGE_SECRET=
