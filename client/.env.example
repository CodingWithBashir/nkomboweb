# ---------------------------------------------------------------------------
# Lycée de Nyanza — optional configuration
# Everything below has a working default in code, so the site runs as-is.
# ---------------------------------------------------------------------------

# Supabase project used for sign-in (public values, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://wmsfhjqhuqdldzkoxozc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shared secret of the `session-bridge` edge function. Rotate it in Supabase
# (Project → Edge Functions → Secrets) and here at the same time.
SUPABASE_BRIDGE_SECRET=

# Optional: verify Supabase access tokens locally instead of using the bridge.
# Copy from Project Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Image host (imgbb / "imgdb"). The school key is built in; override it here.
IMGBB_API_KEY=

# Where the standalone API runs; the website proxies /api/** and /uploads/** here
API_ORIGIN=http://127.0.0.1:4000

# Where the SQLite database lives (the API owns server/data/school.db)
SCHOOL_DB_PATH=
